# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.spec.bak

# Virtual environments
.venv/
venv/
env/

# IDE and editor state
.vscode/
.idea/
.codex/
*.swp

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Satellite protocol and generated state
.protocol/
.protocol-eval/
.protocol-inbox/
.vibecoderproof/
.protocol/metadata/backups/
.protocol/evidence/*.json
!.protocol/evidence/.gitkeep
.protocol/codebase_map.json
.protocol/remediation_queue.json
.protocol/metadata/alignment_report.json
exports/

# Local secrets
.secrets/*
!.secrets/
!.secrets/.gitignore
!.secrets/.secretsrc
!.secrets/**/*.example

# Legacy dotenv files
**/.env
!**/.env.example

# Claude local cache
.claude/cache/
.claude/scheduled_tasks.lock
# --- Cerberus governance (generated) ---
__pycache__/
*.py[cod]
.venv/
.protocol/evidence/
.protocol/cache/

# .protocol-core/ is resolved at runtime from the pinned
# install; it is derived output and must never be versioned.
.protocol-core/

# .goodcode/last_backlog_verdict.json lo reescribe finding_backlog en cada
# corrida del gate y queda obsoleto en cuanto HEAD se mueve: estado por
# corrida, no fuente. El resto de la flota ya lo ignoraba; este repo no.
.goodcode/

# simplecode local cache -- ignore CONTENTS (not the directory itself: a
# negation below cannot re-include a file inside a fully-ignored directory,
# only inside one whose contents are ignored via a trailing /*).
.simplecode/*
# ...except real project config that must persist across syncs/clones, not
# per-run local state: coverage_targets tells coverage_target.py which
# modules to measure on this flat-layout (no src/) repo instead of
# COULD_NOT_RUN'ing forever (see DEBT-gate-failure-coverage-100...).
!.simplecode/corpus_exempt.yaml

# coverage artifacts (regenerated per run)
.coverage
.coverage.*
.coverage_watermark
htmlcov/
.benchmarks/
